pipeline{
    agent any
    environment{
        B_No = "${BUILD_NUMBER}"
    }
    tools{
        maven "maven-3.9.16"
    }
    stages{
       stage("git Checkout"){
           steps{
               git branch:"main",
               url:"https://github.com/blpk2005/maven-webapplication-project-kkfund.git"
           }
       }
        stage("mvn version checking"){
           steps{
               sh "mvn --version"
           }
       }
        stage("compile"){
           steps{
               sh "mvn compile"
           }
       }
        stage("Build artifact"){
           steps{
               sh "mvn clean package"
           }
       }
        stage("SonarQube Report"){
           steps{
               sh "mvn sonar:sonar"
           }
       }
        stage("Artifact Backup"){
           steps{
               sh "mvn deploy"
           }
       }
      stage("Deploy Tomcat"){
    steps{
        sh """
            curl -u admin:admin \
            --upload-file ${WORKSPACE}/target/maven-web-application.war \
            "http://54.145.231.171:8080/manager/text/deploy?path=/maven-web-application&update=true"
        """
    }
}
       
    }
}
